(type MInst 
    (enum
    ;; No operation is performed
    (Nop)
    ;; Suspends CPU operation until an interrupt or reset occurs.
    (Halt)
    (Trap)
    (Move8 (dst WritableReg) (src Reg))
    (Add8 (dst WritableReg) (lhs Reg) (rhs Reg))
    (Add16 (accumulator WritableReg) (dst_low WritableReg) (dst_high WritableReg) (lhs_low Reg) (lhs_high Reg) (rhs_low Reg) (rhs_high Reg))
    (Sub8 (dst WritableReg) (lhs Reg) (rhs Reg))
    (Sub16 (accumulator WritableReg) (dst_low WritableReg) (dst_high WritableReg) (lhs_low Reg) (lhs_high Reg) (rhs_low Reg) (rhs_high Reg))
    (Compare8 (accumulator WritableReg) (scratch WritableReg) (dst WritableReg) (lhs Reg) (rhs Reg) (condition IntCC))
    (Compare16 (accumulator WritableReg) (scratch WritableReg) (dst WritableReg) (lhs_low Reg) (lhs_high Reg) (rhs_low Reg) (rhs_high Reg) (condition IntCC))
    (And8 (dst WritableReg) (lhs Reg) (rhs Reg))
    (Or8 (dst WritableReg) (lhs Reg) (rhs Reg))
    (Xor8 (dst WritableReg) (lhs Reg) (rhs Reg))
    (LoadImm8 (dst WritableReg) (imm u8))
    (LoadSymbol16 (dst_low WritableReg) (dst_high WritableReg) (scratch_h WritableReg) (scratch_l WritableReg) (name ExternalName) (offset i64))
    (LoadMem8 (address_low Reg) (address_high Reg) (offset i32) (scratch_h WritableReg) (scratch_l WritableReg) (accumulator WritableReg) (dst WritableReg))
    (LoadMem16 (address_low Reg) (address_high Reg) (offset i32) (scratch_h WritableReg) (scratch_l WritableReg) (accumulator WritableReg) (dst_low WritableReg) (dst_high WritableReg))
    (StoreMem8 (address_low Reg) (address_high Reg) (offset i32) (scratch_h WritableReg) (scratch_l WritableReg) (accumulator WritableReg) (src Reg))
    (StoreMem16 (address_low Reg) (address_high Reg) (offset i32) (scratch_h WritableReg) (scratch_l WritableReg) (accumulator WritableReg) (src_low Reg) (src_high Reg))
    (LoadStack8 (dst WritableReg) (mode StackAMode))
    (StoreStack8 (src Reg) (mode StackAMode))
    (StackAddr16 (dst_low WritableReg) (dst_high WritableReg) (mode StackAMode))
    (AdjustSP (amount i8))
    (DummyUse (reg Reg))
    (Args (args VecArgPair))
    (Rets (rets VecRetPair))
    (CallKnown (info BoxCallInfo))
    (JumpKnown (dst MachLabel))
    (BranchIf (condition Reg) (taken MachLabel) (not_taken MachLabel))
    (Ret)
))

(type StackAMode extern (enum))
