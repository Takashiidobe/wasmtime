(type MInst 
    (enum
    ;; No operation is performed
    (Nop)
    ;; Suspends CPU operation until an interrupt or reset occurs.
    (Halt)
    (Move8 (dst WritableReg) (src Reg))
    (Add8 (dst WritableReg) (lhs Reg) (rhs Reg))
    (Sub8 (dst WritableReg) (lhs Reg) (rhs Reg))
    (And8 (dst WritableReg) (lhs Reg) (rhs Reg))
    (Or8 (dst WritableReg) (lhs Reg) (rhs Reg))
    (Xor8 (dst WritableReg) (lhs Reg) (rhs Reg))
    (LoadImm8 (dst WritableReg) (imm u8))
    (LoadStack8 (dst WritableReg) (mode StackAMode))
    (StoreStack8 (src Reg) (mode StackAMode))
    (AdjustSP (amount i8))
    (DummyUse (reg Reg))
    (Args (args VecArgPair))
    (Rets (rets VecRetPair))
    (CallKnown (info BoxCallInfo))
    (JumpKnown (dst MachLabel))
    (Ret)
))

(type StackAMode extern (enum))
